# Copy to .env and fill in (never commit .env)
# cp .env.example .env

# --- MongoDB (ETSReviews export) ---
MONGODB_URI=
MONGODB_DB=production
MONGODB_COLLECTION=ETSReviews

# Pivony naming (optional aliases; used if MONGODB_* above are empty)
# PRODUCTION_MONGODB_URI=
# PRODUCTION_MONGODB_DATABASE=production

# --- Export tuning ---
ETS_DAYS_BACK=365
# ETS_MAX_REVIEWS=5000
# ETS_SKIP_EXISTING=true
# ETS_EXPORT_MODE=monthly

# --- Qdrant / GCS (ingest.py, advisor) ---
GOOGLE_APPLICATION_CREDENTIALS=config/google_creds.json
QDRANT_HOST=127.0.0.1
GCS_BUCKET_NAME=pivony-advisor
GCP_PROJECT=pivony-ab6d2
