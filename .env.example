# Copy to .env and fill in (never commit .env)
# cp .env.example .env

# --- MongoDB (ETSReviews export) ---
PRODUCTION_MONGODB_URI=
MONGO_COLLECTION=ETSReviews
MONGODB_DB=production
# ETS stores submission date in sk (dd-mm-yyyy HH:mm:ss)
# ETS_DATE_FIELD=sk,ReviewSubmissionDate

# --- Export tuning ---
ETS_DAYS_BACK=365
# Fixed window (overrides ETS_DAYS_BACK when set):
# ETS_DATE_FROM=2025-01-01
# ETS_DATE_TO=2026-05-31
# Which hotels/pivots to export (all from .env):
# ETS_HOTEL_FIELD=vendorName
# ETS_HOTEL_NAMES=Otel A,Otel B
# ETS_PIVOT_FILTERS_JSON={"vendorName":["Otel A","Otel B"],"region":["Antalya"]}
# ETS_PIVOT_MATCH=all
#   all = AND across keys, OR within each key (typical hotel list)
#   any = OR across keys
# Full Mongo doc per review (all CustomAttributes + fields as JSON block):
# ETS_EXPORT_FULL_MONGO=true
# ETS_EXPORT_INCLUDE_ANALYSIS=false
# ETS_EXPORT_MAX_JSON_CHARS=12000
# ETS_MAX_REVIEWS=5000
# ETS_SKIP_EXISTING=false
# ETS_REVIEWS_PER_FILE=200
# ETS_CURSOR_BATCH_SIZE=50
# ETS_EXPORT_LOG_PATH=logs/ets_export.log

# --- Ingest (local hospitality -> Qdrant) ---
# INGEST_LOCAL_DIR=output/hospitality
# INGEST_LOCAL_PREFIX=hospitality
# INGEST_PROGRESS_EVERY=25
# INGEST_BATCH_SIZE=16
# (Vertex embed limit ~20k tokens/request; keep batch small)
# INGEST_CHECKPOINT_PATH=run/ingest_checkpoint.json
# INGEST_RESUME=true
# INGEST_BOOTSTRAP_CHECKPOINT=true
#   one-time: seed checkpoint from logs/ingest.log after a crash (then set false)
# INGEST_BY_MONTH=true
# INGEST_FROM_MONTH=2025-08
# INGEST_ONLY_MONTH=2025-09
# INGEST_LOG_PATH=logs/ingest.log
# Background: ./scripts/run_ingest_background.sh start  (see docs/HOSPITALITY_ETSREVIEWS.md)

# --- Qdrant / GCS (ingest.py, advisor) ---
GOOGLE_APPLICATION_CREDENTIALS=config/google_creds.json
QDRANT_HOST=127.0.0.1
GCS_BUCKET_NAME=pivony-advisor
GCP_PROJECT=pivony-ab6d2

# --- Advisor chat (Vertex Gemini; separate from Welcome GenAI widget LLM config) ---
# ADVISOR_LLM_MODEL=gemini-2.5-flash
# Legacy alias (deprecated): LLM_MODEL

# --- Faz 3: freemium Advisor metrics (get_pivony_metrics -> pivony-api) ---
# Full URL to pivony-api advisor-metrics worker route.
#   production:  http://<pivony-api-host>/api/v1/welcome/worker/advisor-metrics
#   development: http://<pivony-api-host>/api/welcome/worker/advisor-metrics
# PIVONY_API_METRICS_URL=
# Must equal pivony-api WELCOME_WORKER_SECRET (sent as X-Welcome-Worker-Key).
# PIVONY_API_WORKER_SECRET=
# PIVONY_API_TIMEOUT_SEC=20
# PIVONY_METRICS_DEFAULT_DAYS=90

# --- CrewAI quality loop (quality_loop/) ---
# CrewAI needs Python >=3.10 and <3.14 — use scripts/bootstrap-quality-loop-venv.sh
# bash scripts/bootstrap-quality-loop-venv.sh
# PIVONY_ADVISOR_URL=http://127.0.0.1:8000
# PIVONY_ADVISOR_API_TOKEN=
# QUALITY_LOOP_USER_ID=
# QUALITY_LOOP_USER_EMAIL=elif@pivony.com
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# QUALITY_LOOP_CX_LLM=gemini/gemini-2.0-flash
# QUALITY_LOOP_QA_LLM=anthropic/claude-sonnet-4-20250514
# QUALITY_LOOP_CODING_LLM=anthropic/claude-sonnet-4-20250514
# QUALITY_LOOP_DATABASE_URL=postgresql://user:pass@host/db
# PIVONY_REPO_ROOT=/path/to/pivony-advisor
# QUALITY_LOOP_UI_MOUNT=true          # → http://<host>:8011/quality-loop/
# QUALITY_LOOP_UI_TOKEN=               # optional auth for public UI

# --- LangSmith tracing (quality loop runtime) ---
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=pivony-quality-loop
# QUALITY_LOOP_LANGSMITH_ENABLED=true
# Vertex 429 resilience (CrewAI / LiteLLM)
# QUALITY_LOOP_VERTEX_MAX_RETRIES=4
# QUALITY_LOOP_VERTEX_BACKOFF_SEC=2,4,8,16
# QUALITY_LOOP_VERTEX_CIRCUIT_COOLDOWN_SEC=45
# QUALITY_LOOP_VERTEX_CIRCUIT_MAX_COOLDOWN_SEC=180
# LANGSMITH_PROJECT_URL=https://smith.langchain.com/o/<org>/projects/p/<project>

# QUALITY_LOOP_ALLOW_GIT_PUSH=false
# QUALITY_LOOP_AUTO_DEPLOY=false
# DEPLOY_CMD=systemctl restart pivony-advisor
