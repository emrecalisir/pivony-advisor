[Unit]
Description=Pivony Advisor RAG API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pivony-advisor
Environment=PYTHONPATH=/home/ubuntu/pivony-advisor/src
Environment=QDRANT_HOST=127.0.0.1
Environment=QDRANT_PORT=6333
# Production instance (development clone uses deploy/pivony-advisor-dev.service on 8012).
ExecStart=/home/ubuntu/pivony-advisor/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8011
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
